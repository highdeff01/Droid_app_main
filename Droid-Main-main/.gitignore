# Dependencies
node_modules/

# Build outputs
dist/
dev-dist/
build/
coverage/
*.tsbuildinfo
android-apk-project/

# Android packages
*.apk
*.aab

# Private on-device recordings copied to the host
.phone-recordings/

# Logs
*.log
npm-debug.log*

# Environment (keep the example)
.env*
!.env.example

# Editors / IDEs
.idea/
.vscode/

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Runtime state written by the app (DurableStore, quarantined corrupt files); never commit
.data/
*.corrupt.*

# Python bytecode caches
__pycache__/
*.py[cod]
